; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Game RPG"
run/main_scene="uid://bs6s78gxa060g"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

LocalSave="*res://services/persistence/local_save_provider.gd"
ContentRepository="*res://services/content/local_content_repository.gd"
GameState="*res://services/game_state/game_state.gd"
CharacterService="*res://systems/character/character_service.gd"
SkillProgression="*res://systems/progression/skill_progression_service.gd"
ItemService="*res://systems/items/item_service.gd"
PhantomCameraManager="*res://addons/phantom_camera/scripts/managers/phantom_camera_manager.gd"

[display]

window/size/viewport_width=3008
window/size/viewport_height=1692
window/stretch/aspect="expand"
window/handheld/orientation=6
window/ios/hide_home_indicator=false

[editor_plugins]

enabled=PackedStringArray("res://addons/phantom_camera/plugin.cfg")

